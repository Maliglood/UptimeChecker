<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Статус — <%= siteName %></title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #0d1117;
      --card: #161b22;
      --border: #30363d;
      --text: #c9d1d9;
      --muted: #8b949e;
    }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    }
    .card {
      width: 100%;
      max-width: 520px;
      margin: 24px;
      padding: 28px 32px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
    }
    h1 {
      margin: 0 0 20px;
      font-size: 1.5rem;
      font-weight: 600;
    }
    .status-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
    }
    .dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: <%= statusColor %>;
      box-shadow: 0 0 0 4px <%= statusColor %>22;
    }
    .status-label {
      font-weight: 600;
      font-size: 1.1rem;
      color: <%= statusColor %>;
    }
    .metrics {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }
    .metric {
      padding: 16px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    .metric-label {
      display: block;
      font-size: 0.8rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 6px;
    }
    .metric-value {
      display: block;
      font-size: 1.4rem;
      font-weight: 700;
    }
    .badge-wrap {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }
    .badge-wrap span {
      color: var(--muted);
      font-size: 0.9rem;
    }
    img {
      display: block;
    }
  </style>
</head>
<body>
  <main class="card">
    <h1><%= siteName %></h1>

    <div class="status-row">
      <span class="dot"></span>
      <span class="status-label"><%= statusLabel %></span>
    </div>

    <div class="metrics">
      <div class="metric">
        <span class="metric-label">Uptime</span>
        <span class="metric-value"><%= uptimePercent.toFixed(3) %>%</span>
      </div>
      <div class="metric">
        <span class="metric-label">Всего проверок</span>
        <span class="metric-value"><%= totalChecks %></span>
      </div>
      <div class="metric">
        <span class="metric-label">Успешных</span>
        <span class="metric-value"><%= successfulChecks %></span>
      </div>
    </div>

    <div class="badge-wrap">
      <span>Публичный бейдж:</span>
      <img src="<%= badgeUrl %>" alt="status badge" height="20">
    </div>
  </main>
</body>
</html>