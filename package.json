{
  "name": "uptime-checker",
  "version": "1.0.0",
  "description": "Uptime monitoring service with NestJS, BullMQ, and Pino",
  "private": true,
  "scripts": {
    "build": "nest build && tsc-alias",
    "start": "nest start",
    "start:dev": "tsc-watch -p tsconfig.json --onSuccess \"tsc-alias -p tsconfig.json && node dist/main.js\"",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "axios": "^1.7.0",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.3.0",
    "pino-http": "^10.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.0.0",
    "pino-pretty": "^11.2.0",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.9.10",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
